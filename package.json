{
  "name": "downstream",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Read a change downstream from its entry points, with the agent in the margin.",
  "type": "module",
  "bin": {
    "downstream": "bin/downstream.mjs"
  },
  "scripts": {
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --no-warnings=ExperimentalWarning --import tsx --test server/analyze/graph.test.ts server/store.test.ts domain/delivery.test.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "diff": "^9.0.0",
    "hono": "^4.13.13",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@pierre/diffs": "^1.5.2",
    "@pierre/trees": "^1.0.0-beta.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.52.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.3"
  }
}
