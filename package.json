{
  "name": "@armanckeser/downstream",
  "version": "0.2.1",
  "license": "MIT",
  "description": "The PR review tool for when agents open more pull requests than you can review. Downstream shows which one to review first, and Claude Code helps you review it.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armanckeser/downstream.git"
  },
  "type": "module",
  "bin": {
    "downstream": "bin/downstream.mjs"
  },
  "files": [
    "bin",
    "dist",
    "web/dist",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --no-warnings=ExperimentalWarning --test server/analyze/graph.test.ts server/store.test.ts domain/delivery.test.ts domain/inbox.test.ts domain/next-move.test.ts domain/approval.test.ts domain/pr-detail.test.ts server/publish.test.ts server/stale.test.ts server/home-store.test.ts",
    "build:cli": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build && npm run build:cli"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@hono/node-server": "^2.1.3",
    "diff": "^9.0.0",
    "hono": "^4.13.13",
    "typescript": "~6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@pierre/diffs": "^1.5.2",
    "@pierre/trees": "^1.0.0-beta.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.52.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
